{
  "name": "antigravity-gateway",
  "version": "2.3.0",
  "description": "Anthropic Messages, OpenAI Responses and Chat Completions gateway with separate Google Antigravity API and Google Gemini API account pools.",
  "license": "MIT",
  "type": "commonjs",
  "main": "antigravity-gateway.js",
  "files": [
    "antigravity-gateway.js",
    "src/",
    "native/bin/",
    "native/GO-LICENSE",
    "scripts/check-environment.js",
    "scripts/install-model-discovery.js",
    "integrations/model-discovery/catalog.cjs",
    "integrations/model-discovery/pi.ts",
    "integrations/model-discovery/dsh.mjs",
    "skills/antigravity-video-understanding/SKILL.md",
    "skills/antigravity-video-understanding/scripts/analyze_video.py",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "antigravity-gateway": "antigravity-gateway.js"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "html2canvas": "1.4.1",
    "ws": "8.22.0"
  },
  "scripts": {
    "start": "node antigravity-gateway.js",
    "postinstall": "node scripts/check-environment.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "antigravity",
    "gemini",
    "anthropic-compatible",
    "openai-compatible",
    "claude-code",
    "codex-cli",
    "gateway"
  ]
}
