# Publish only the gateway runtime, installation files and user entry points.
# Development records, tests and tooling stay in this local working directory.
/*
!/.gitignore
!/LICENSE
!/README.md
!/package.json
!/package-lock.json
!/antigravity-gateway.js
!/src/
!/native/
/native/*
!/native/GO-LICENSE
!/native/bin/
/native/bin/*
!/native/bin/manifest.json
!/native/bin/agy-transport-*.gz
!/scripts/
/scripts/*
!/scripts/check-environment.js
!/scripts/install-model-discovery.js
!/integrations/
/integrations/*
!/integrations/model-discovery/
/integrations/model-discovery/*
!/integrations/model-discovery/catalog.cjs
!/integrations/model-discovery/pi.ts
!/integrations/model-discovery/dsh.mjs
!/skills/
/skills/*
!/skills/antigravity-video-understanding/
/skills/antigravity-video-understanding/*
!/skills/antigravity-video-understanding/SKILL.md
!/skills/antigravity-video-understanding/scripts/
/skills/antigravity-video-understanding/scripts/*
!/skills/antigravity-video-understanding/scripts/analyze_video.py

# Never include local dependencies, credentials, account state or logs.
node_modules/
__pycache__/
*.pyc
*.log
.DS_Store
.env
.env.*
*.pem
*.key
*.p12
.antigravity-gateway/
accounts/
gemini-accounts/
oauth_creds.json
antigravity-oauth-token
jetski-standalone-oauth-token
